MASIR_ENV=production
MASIR_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
MASIR_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
MASIR_DATABASE_POOL_SIZE=5
MASIR_DATABASE_MAX_OVERFLOW=10
MASIR_FRONTEND_ORIGIN=https://example.com
MASIR_ACCESS_TOKEN_MINUTES=30
MASIR_REFRESH_TOKEN_DAYS=14
